# Configuration IA Service
APP_NAME=BFExpress IA Service
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Azure OpenAI Configuration (Option 1)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2023-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Hugging Face Configuration (Option 2 - Local/Free)
HUGGINGFACE_MODEL=camembert-base
HUGGINGFACE_SENTIMENT_MODEL=camembert-base-sentiment
HUGGINGFACE_CLASSIFIER=model=facebook/bart-large-mnli
USE_LOCAL_MODEL=True

# Database Configuration (Optional)
DATABASE_URL=sqlite:///./ia_service.db

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500